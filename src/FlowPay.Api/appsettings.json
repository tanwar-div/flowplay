{
  "ConnectionStrings": {
    "FlowPay": "Host=localhost;Port=5432;Database=flowpay;Username=flowpay;Password=flowpay;Maximum Pool Size=100;Minimum Pool Size=10;Timeout=15;Command Timeout=30;No Reset On Close=true"
  },
  "FlowPay": {
    "PlatformFeeAccounts": {
      "USD": "00000000-0000-7000-8000-000001000000",
      "EUR": "00000000-0000-7000-8000-000002000000",
      "GBP": "00000000-0000-7000-8000-000003000000"
    },
    "FeeAccountShards": 16,
    "FeeBasisPoints": 290,
    "FeeFixedMinorUnits": 30,
    "IdempotencyRetention": "24:00:00",
    "Hosting": {
      "RunOutboxDispatcher": false
    },
    "Outbox": {
      "BatchSize": 256,
      "PollInterval": "00:00:00.250",
      "MaxAttempts": 8,
      "RetryBaseDelay": "00:00:01",
      "RetryMaxDelay": "00:05:00",
      "RetryJitterFactor": 0.5,
      "PendingDepthWarningThreshold": 10000
    },
    "Maintenance": {
      "AuthorizationExpirySweepInterval": "00:05:00",
      "AuthorizationExpiryBatchSize": 200,
      "IdempotencyPurgeInterval": "00:15:00",
      "IdempotencyPurgeBatchSize": 5000
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "flowpay",
    "Password": "flowpay",
    "ClientProvidedName": "flowpay-api",
    "PrefetchCount": 32,
    "MaxDeliveryAttempts": 4,
    "NetworkRecoveryIntervalSeconds": 5,
    "DeclareTopology": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 2000,
      "MaxRequestBodySize": 65536
    }
  },
  "AllowedHosts": "*"
}
