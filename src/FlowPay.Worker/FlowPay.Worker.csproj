<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>FlowPay.Worker</RootNamespace>
    <UserSecretsId>flowpay-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />

    <!-- Serilog.Extensions.Hosting, not Serilog.AspNetCore. The latter carries a
         FrameworkReference to Microsoft.AspNetCore.App, which would force this
         background service to be deployed on the ASP.NET Core shared framework it has no
         use for, and would bloat its container image to match. -->
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlowPay.Infrastructure\FlowPay.Infrastructure.csproj" />
  </ItemGroup>

</Project>
