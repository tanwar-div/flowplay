<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>FlowPay.LoadTest</RootNamespace>
    <OutputType>Exe</OutputType>
    <AssemblyName>flowpay-loadtest</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- The harness must not be the bottleneck it is trying to measure: server GC keeps
         allocation pauses off the measured latencies at high concurrency. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlowPay.Domain\FlowPay.Domain.csproj" />
  </ItemGroup>

</Project>
