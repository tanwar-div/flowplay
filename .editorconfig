root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
max_line_length = 100

# File-scoped namespaces and explicit types throughout: the codebase leans on strongly
# typed primitives (Money, Currency, AccountId), and `var` would hide exactly the
# distinctions those types exist to make visible.
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion

csharp_prefer_braces = true:error
csharp_style_prefer_primary_constructors = false:suggestion
csharp_new_line_before_open_brace = all

dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

dotnet_style_readonly_field = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error

[*.{json,yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 4

[*.{props,targets,csproj,slnx}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
